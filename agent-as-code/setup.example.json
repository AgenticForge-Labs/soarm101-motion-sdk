{
  "experiment": {
    "name": "agent-as-code",
    "task_file": "TASK.example.md"
  },
  "agents": {
    "codex": {
      "model": ""
    },
    "hermes": {
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4.1-flash"
    }
  },
  "robot": {
    "port": "/dev/ttyACM0",
    "robot_id": "so101",
    "calibration": null
  },
  "cameras": [
    {
      "name": "primary",
      "primary": true,
      "enabled": true,
      "device": "/dev/v4l/by-id/REPLACE_WITH_PRIMARY_CAMERA",
      "width": 1280,
      "height": 720,
      "fps": 30,
      "fourcc": "MJPG",
      "mirror": false
    },
    {
      "name": "side",
      "primary": false,
      "enabled": false,
      "device": "/dev/video2",
      "width": 1280,
      "height": 720,
      "fps": 30,
      "fourcc": "MJPG",
      "mirror": false
    }
  ],
  "executor": {
    "port": 8765,
    "max_jog_mm": 10.0,
    "max_jog_deg": 5.0,
    "max_speed_mm_s": 10.0,
    "max_acceleration_mm_s2": 40.0,
    "max_observation_bytes": 25000000,
    "command_timeout_seconds": 180
  },
  "run": {
    "output_dir": "agent-as-code/runs"
  }
}
