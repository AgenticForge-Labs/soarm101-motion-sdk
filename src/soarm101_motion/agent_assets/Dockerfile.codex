FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10000 agent \
    && useradd -m -u 10000 -g 10000 agent \
    && mkdir -p /sandbox /opt/codex-install \
    && chown -R 10000:10000 /sandbox /opt/codex-install

ENV CODEX_INSTALL_DIR=/usr/local/bin
ENV CODEX_HOME=/opt/codex-install
ENV CODEX_NON_INTERACTIVE=1

RUN curl -fsSL https://chatgpt.com/codex/install.sh | sh \
    && codex --version

# MCP runs use an isolated Python environment; robotctl remains independent.
RUN python3 -m venv /opt/soarm101-mcp \\
    && /opt/soarm101-mcp/bin/pip install --no-cache-dir 'mcp>=2,<3'

WORKDIR /sandbox
# OpenShell's Docker identity resolver creates the image before the requested
# sandbox command override is applied, so the image must have a valid default
# command. Keep it inert and long-lived; OpenShell still overrides it at run time.
ENTRYPOINT []
CMD ["/bin/sh", "-lc", "while :; do sleep 3600; done"]
USER 10000:10000
